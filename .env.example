# ==============================================================================
# Maharaja Agrasen Foundation Limited Singapore - Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase Transaction Pooler)
# ------------------------------------------------------------------------------
# Recommended: Supabase AWS Transaction Pooler (Port 6543) with SSL enabled
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security (HMAC-SHA256)
# ------------------------------------------------------------------------------
# 32+ character random secret used to cryptographically sign httpOnly session cookies
AUTH_SECRET="generate_a_random_32_byte_hex_or_base64_string"

# Master security password required to unlock the Community Admin moderation portal
ADMIN_MASTER_PASSWORD="your_secure_admin_master_password"

# Set to "true" to force redirecting unauthenticated visitors from /directory & /dashboard
ENFORCE_STRICT_AUTH="true"

# ------------------------------------------------------------------------------
# 3. Transactional Messaging (Twilio WhatsApp)
# ------------------------------------------------------------------------------
# Twilio Account SID & Auth Token from Twilio Console
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ------------------------------------------------------------------------------
# 4. Transactional Email (Resend API)
# ------------------------------------------------------------------------------
# Resend API Key from resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. Media & Storage CDN (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Base domain used for member profile pictures and community banners
NEXT_PUBLIC_CDN_DOMAIN="https://media.agarwal-directory.org"
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_number
SENDGRID_API_KEY=your_key
